# Variables para DESARROLLO local. No utilizar estos valores en produccion.
POSTGRES_DB=smarthome
POSTGRES_USER=smarthome
POSTGRES_PASSWORD=smarthome_dev_only
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
MAILPIT_WEB_PORT=8025

# Envío de correo: "mailpit" (pruebas) o "resend" (entrega a emails reales)
MAIL_PROVIDER=mailpit
# Copia tu clave real de https://resend.com/api-keys en .env LOCAL, no aquí.
RESEND_API_KEY=
# Remitente del subdominio que verificaste en Resend.
RESEND_FROM_EMAIL=notificaciones@smarthome.votaya.com.mx
